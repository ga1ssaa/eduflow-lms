# Local development only. Replace these values before any shared deployment.
POSTGRES_DB=eduflow
POSTGRES_USER=eduflow
POSTGRES_PASSWORD=local-development-only
# Docker Compose uses the postgres service hostname; PostgreSQL has no host port.
DATABASE_URL=postgresql+psycopg://eduflow:local-development-only@postgres:5432/eduflow
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Required: generate a unique random secret in your ignored .env; see README.
JWT_SECRET=
JWT_ISSUER=eduflow
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
ENVIRONMENT=development
AUTH_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000"]
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_NAME=eduflow_refresh
