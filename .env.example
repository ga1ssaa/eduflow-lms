# Local development only. Replace these values before any shared deployment.
POSTGRES_DB=eduflow
POSTGRES_USER=eduflow
POSTGRES_PASSWORD=local-development-only
# Docker Compose uses the postgres service hostname; PostgreSQL has no host port.
DATABASE_URL=postgresql+psycopg://eduflow:local-development-only@postgres:5432/eduflow
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
