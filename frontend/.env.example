# Public frontend configuration. Never put signing secrets or credentials here.
VITE_API_BASE_URL=/api/v1
# Production: keep this relative URL and configure the Vercel external rewrite.
# Do not set this to Render's cross-site URL; refresh cookies use the frontend origin.
# Vite-only server setting; it is not exposed in the browser bundle.
EDUFLOW_API_PROXY_TARGET=http://127.0.0.1:8000
